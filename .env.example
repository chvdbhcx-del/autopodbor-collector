# --- Telegram userbot (отдельный аккаунт; ключи на https://my.telegram.org -> API development tools) ---
TG_API_ID=
TG_API_HASH=
# Строка сессии: её печатает `npm run login` после входа в аккаунт.
TG_SESSION=
# Бот, куда сборщик шлёт данные, без @
BOT_USERNAME=

# --- Перевод и разбор постов (Claude API) ---
ANTHROPIC_API_KEY=
# По умолчанию самая сильная модель. claude-haiku-5-5 в десятки раз дешевле и обычно справляется с переводом.
LLM_MODEL=claude-opus-5-5

# --- Сеть (необязательно) ---
# Encar иногда режет зарубежные IP: http://user:pass@host:port прокси в Корее или Азии.
ENCAR_PROXY=
