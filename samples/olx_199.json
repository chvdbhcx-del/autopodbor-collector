{"data":[{"id":1113453076,"url":"https://www.olx.pl/d/oferta/peugeot-308-t9-2-0-gt-180km-panorama-full-skora-denon-CID5-ID1dlV0A.html","title":"PEUGEOT 308 T9 2.0 GT 180KM Panorama/Full sk\u00f3ra/Denon","last_refresh_time":"2026-11-26T15:49:08+01:00","created_time":"2026-11-19T15:47:49+01:00","valid_to_time":"2026-12-19T15:49:04+01:00","pushup_time":"2026-11-26T15:49:08+01:00","omnibus_pushup_time":"2026-11-26T15:49:08+01:00","description":"Witam\u003Cbr /\u003E\n\u003Cbr /\u003E\nPrzedmiotem ogloszenia jest m\u00f3j prywatny samoch\u00f3d Peugeot 308 T9 GT 2.0HDI o mocy 180km i automatyczn\u0105 skrzyni\u0105 bieg\u00f3w EAT6\u003Cbr /\u003E\n\u003Cbr /\u003E\n(silnik jak i skrzynia pracuj\u0105 bez zastrze\u017ce\u0144 )\u003Cbr /\u003E\n\u003Cbr /\u003E\nPrzy przebiegu 157 tys zosta\u0142 wymieniony rozrz\u0105d i olej w skrzyni bieg\u00f3w metod\u0105 dynamiczn\u0105\u003Cbr /\u003E\n\u003Cbr /\u003E\nNa aucie s\u0105 roczne opony wielosezonowe Goodyear Vector 4Seasons Gen-3 kt\u00f3re spokojnie przejad\u0105 jeszcze 30tys km\u003Cbr /\u003E\n\u003Cbr /\u003E\nW zawieszeniu nic nie stuka nie puka prowadzi sie bardzo dobrze (nie \u015bci\u0105ga)\u003Cbr /\u003E\n\u003Cbr /\u003E\nWszystkie serwisy by\u0142y robione na bie\u017c\u0105co\u003Cbr /\u003E\n\u003Cbr /\u003E\nPrzegl\u0105d i ubezpieczenie do wrze\u015bnia 2027r\u003Cbr /\u003E\n\u003Cbr /\u003E\nAuto na dzie\u0144 dzisiejszy nie wymaga \u017cadnego wk\u0142adu finansowego\u003Cbr /\u003E\n\u003Cbr /\u003E\nWyposa\u017cenie\u003Cbr /\u003E\n\u003Cbr /\u003E\n4x el szyby\u003Cbr /\u003E\n\u003Cbr /\u003E\n2x el lusterka\u003Cbr /\u003E\n\u003Cbr /\u003E\nCzujnik martwego pola\u003Cbr /\u003E\n\u003Cbr /\u003E\nKamera cofania\u003Cbr /\u003E\n\u003Cbr /\u003E\nCzujniki parkowania prz\u00f3d i ty\u0142\u003Cbr /\u003E\n\u003Cbr /\u003E\nAsystent parkowania\u003Cbr /\u003E\n\u003Cbr /\u003E\nElektryczne siedzenie kierowcy\u003Cbr /\u003E\n\u003Cbr /\u003E\nMasa\u017ce w przednich siedzeniach\u003Cbr /\u003E\n\u003Cbr /\u003E\nPodgrzewane siedzenia przednie\u003Cbr /\u003E\n\u003Cbr /\u003E\nPanorama\u003Cbr /\u003E\n\u003Cbr /\u003E\nNag\u0142o\u015bnienie Denon\u003Cbr /\u003E\n\u003Cbr /\u003E\nKlimatyzowany schowek\u003Cbr /\u003E\n\u003Cbr /\u003E\nKlimatyzacja dwustrefowa\u003Cbr /\u003E\n\u003Cbr /\u003E\nFull sk\u00f3ra\u003Cbr /\u003E\n\u003Cbr /\u003E\n\u015awiat\u0142a full led\u003Cbr /\u003E\n\u003Cbr /\u003E\nMo\u017cliwe \u017ce o czym\u015b zapomnia\u0142em\u003Cbr /\u003E\n\u003Cbr /\u003E\nCena 37900 do negocjacji  zadzwo\u0144 napewno sie dogadamy","promotion":{"highlighted":false,"urgent":false,"top_ad":false,"options":[],"b2c_ad_page":true,"premium_ad_page":true},"params":[{"key":"vin","name":"Numer VIN","type":"input","value":{"key":"VF3LHAHWWFS113088","label":"VF3LHAHWWFS113088 "}},{"key":"price","name":"Cena","type":"price","value":{"value":37900,"type":"arranged","arranged":true,"budget":false,"currency":"PLN","negotiable":true,"converted_value":null,"previous_value":null,"converted_previous_value":null,"converted_currency":null,"label":"37 900 z\u0142","previous_label":null}},{"key":"model","name":"Model","type":"select","value":{"key":"308","label":"308"}},{"key":"year","name":"Rok produkcji","type":"input","value":{"key":"2015","label":"2015 "}},{"key":"petrol","name":"Paliwo","type":"select","value":{"key":"diesel","label":"Diesel"}},{"key":"car_body","name":"Typ nadwozia","type":"select","value":{"key":"hatchback","label":"Hatchback"}},{"key":"color","name":"Kolor","type":"select","value":{"key":"niebieski","label":"Niebieski"}},{"key":"enginesize","name":"Poj. silnika","type":"input","value":{"key":"2000","label":"2 000 cm\u00b3"}},{"key":"condition","name":"Stan techniczny","type":"select","value":{"key":"notdamaged","label":"Nieuszkodzony"}},{"key":"transmission","name":"Skrzynia bieg\u00f3w","type":"select","value":{"key":"automatic","label":"Automatyczna"}},{"key":"enginepower","name":"Moc silnika","type":"input","value":{"key":"180